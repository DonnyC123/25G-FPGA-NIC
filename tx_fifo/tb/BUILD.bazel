load("@rules_cocotb//cocotb:cocotb_test.bzl", "cocotb_test")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

verilog_library(
    name = "tx_fifo_top",
    srcs = ["tx_fifo_top.sv"],
    visibility = ["//tools:__pkg__"],
    deps = [
        "//rtl_utils/if:axi_stream_if",
        "//rtl_utils/if:tx_eth_stream_if",
        "//tx_fifo/rtl:tx_fifo_ctrl",
    ],
)

py_library(
    name = "tx_fifo_tb",
    srcs = glob(
        ["*.py"],
        exclude = ["tx_fifo_test.py"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        "//tb_utils",
        "//tb_utils/net",
        "//tools/cocotb",
    ],
)

SIM_OPTS = select({
    "//:sim_questa": [
        "-timescale",
        "1ns/1ps",
    ],
    "//:sim_verilator": [
        "--timescale",
        "1ns/1ps",
    ],
})

TX_FIFO_CASES = {
    "tx_fifo_test": 64,
    "tx_fifo_test_small_fifo": 8,
}

[
    cocotb_test(
        name = name,
        srcs = ["tx_fifo_test.py"],
        module = ":tx_fifo_top",
        params = [
            "FIFO_DEPTH=%d" % fifo_depth,
        ],
        sim_opts = SIM_OPTS,
        deps = [":tx_fifo_tb"],
    )
    for name, fifo_depth in TX_FIFO_CASES.items()
]
