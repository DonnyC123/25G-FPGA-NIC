load("@rules_cocotb//cocotb:cocotb_test.bzl", "cocotb_test")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

verilog_library(
    name = "rx_fifo_top",
    srcs = ["rx_fifo_top.sv"],
    visibility = ["//tools:__pkg__"],
    deps = [
        "//common/pkg:pcs_pkg",
        "//rtl_utils/if:axi_stream_if",
        "//rx_fifo/rtl:rx_fifo_ctrl",
    ],
)

py_library(
    name = "rx_fifo_tb",
    srcs = glob(
        ["*.py"],
        exclude = ["rx_fifo_test.py"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        "//common/pkg:pcs_pkg_py",
        "//tb_utils",
        "//tb_utils/net",
        "//tools/cocotb",
    ],
)

SIM_OPTS = select({
    "//:sim_questa": [
        "-timescale",
        "1ns/1ps",
    ],
    "//:sim_verilator": [
        "--timescale",
        "1ns/1ps",
    ],
})

RX_FIFO_CASES = {
    "rx_fifo_test": 64,
    "rx_fifo_test_small_fifo": 8,
}

[
    cocotb_test(
        name = name,
        srcs = ["rx_fifo_test.py"],
        module = ":rx_fifo_top",
        params = [
            "FIFO_DEPTH=%d" % fifo_depth,
        ],
        sim_opts = SIM_OPTS,
        deps = [":rx_fifo_tb"],
    )
    for name, fifo_depth in RX_FIFO_CASES.items()
]
