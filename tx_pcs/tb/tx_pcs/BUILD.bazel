load("@rules_cocotb//cocotb:cocotb_test.bzl", "cocotb_test")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

verilog_library(
    name = "tx_pcs_top",
    srcs = ["tx_pcs_top.sv"],
    visibility = ["//tools:__pkg__"],
    deps = [
        "//common/pkg:pcs_pkg",
        "//rtl_utils/if:tx_eth_stream_if",
        "//tx_pcs/rtl:tx_pcs",
    ],
)

py_library(
    name = "tx_pcs_tb",
    srcs = ["tx_pcs_test_base.py"],
    deps = [
        "//common/pkg:pcs_pkg_py",
        "//tb_utils",
        "//tb_utils/net",
        "//tools/cocotb",
    ],
)

TX_PCS_CASES = {
    "tx_pcs_test": 60,
    "tx_pcs_test_min_64": 64,
}

[
    cocotb_test(
        name = name,
        srcs = ["tx_pcs_test.py"],
        module = ":tx_pcs_top",
        params = [
            "MIN_FRAME_BYTES=%d" % min_frame_bytes,
        ],
        deps = [":tx_pcs_tb"],
    )
    for name, min_frame_bytes in TX_PCS_CASES.items()
]
