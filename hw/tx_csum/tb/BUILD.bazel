    srcs = ["csum_insert_test.py"],
    module = ":csum_insert_top",
    deps = [":csum_tb"],
)

ASYNC_FIFO_CASES = {
    "async_fifo_test": 4,
    "async_fifo_test_deep": 64,
}

[
    cocotb_test(
        name = name,
        srcs = ["async_fifo_test.py"],
        module = ":async_fifo_top",
        params = [
            "FIFO_DEPTH=%d" % depth,
        ],
        deps = ["//hw/tb_utils"],
    )
    for name, depth in ASYNC_FIFO_CASES.items()
]
