    deps = [
        "//hw/common/pkg:parser_pkg",
        "//hw/parser/rtl:pkt_parser",
        "//hw/rtl_utils/if:axi_stream_if",
        "//hw/tx_csum/rtl:csum_calc",
    ],
)

verilog_library(
    name = "csum_insert_top",
    srcs = ["csum_insert_top.sv"],
    visibility = ["//tools:__pkg__"],
    deps = [
        "//hw/common/pkg:parser_pkg",
        "//hw/rtl_utils/if:tx_eth_stream_if",
        "//hw/tx_csum/rtl:csum_insert",
    ],
)

verilog_library(
    name = "async_fifo_top",
    srcs = ["async_fifo_top.sv"],
    visibility = ["//tools:__pkg__"],
    deps = ["//hw/rtl_utils:async_fifo"],
)

py_library(
