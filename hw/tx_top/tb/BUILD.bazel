load("@rules_cocotb//cocotb:cocotb_test.bzl", "cocotb_test")
load("@rules_python//python:defs.bzl", "py_library")
load("@rules_verilog//verilog:defs.bzl", "verilog_library")

verilog_library(
    name = "tx_top_wrapper",
    srcs = ["tx_top_wrapper.sv"],
    visibility = ["//tools:__pkg__"],
    deps = [
        "//hw/common/pkg:pcs_pkg",
        "//hw/rtl_utils/if:axi_stream_if",
        "//hw/tx_top/rtl:tx_top",
    ],
)

py_library(
    name = "tx_top_tb",
    srcs = ["tx_test_base.py"],
    deps = [
        "//hw/tb_utils",
        "//hw/tb_utils/net",
        "//tools/cocotb",
    ],
)

SIM_OPTS = select({
    "//:sim_questa": [
        "-timescale",
        "1ns/1ps",
    ],
    "//:sim_verilator": [
        "--timescale",
        "1ns/1ps",
    ],
})

TX_CASES = {
    "tx_test": 64,
    "tx_test_small_fifo": 4,
}

[
    cocotb_test(
        name = name,
        srcs = ["tx_test.py"],
        module = ":tx_top_wrapper",
        params = [
            "FIFO_DEPTH=%d" % fifo_depth,
        ],
        sim_opts = SIM_OPTS,
        deps = [":tx_top_tb"],
    )
    for name, fifo_depth in TX_CASES.items()
]
