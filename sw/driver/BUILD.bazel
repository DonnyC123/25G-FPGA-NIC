genrule(
    name = "eth_xdma",
    srcs = glob([
        "*.c",
        "*.h",
    ]) + ["Makefile"],
    outs = ["eth_xdma.ko"],
    cmd = """
build_dir="$$(mktemp -d)"
trap 'rm -rf "$$build_dir"' EXIT
cp $(SRCS) "$$build_dir"
make -C "$$build_dir" all
cp "$$build_dir/eth_xdma.ko" $@
""",
    local = True,
    tags = ["manual"],
)
