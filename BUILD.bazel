load("@bazel_skylib//rules:common_settings.bzl", "string_flag")

exports_files(["verible.filelist"])

string_flag(
    name = "sim",
    build_setting_default = "verilator",
    values = [
        "questa",
        "verilator",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "sim_questa",
    flag_values = {":sim": "questa"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "sim_verilator",
    flag_values = {":sim": "verilator"},
    visibility = ["//visibility:public"],
)
