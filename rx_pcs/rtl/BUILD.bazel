load("@rules_verilog//verilog:defs.bzl", "verilog_library")

# Target names must match the SV module names: rules_cocotb uses them as the HDL toplevel.
verilog_library(
    name = "alignment_finder",
    srcs = ["alignment_finder.sv"],
    visibility = ["//visibility:public"],
    deps = ["//common/pkg:pcs_pkg"],
)

verilog_library(
    name = "block_sync",
    srcs = ["block_sync.sv"],
    visibility = ["//visibility:public"],
    deps = ["//rtl_utils:data_status_pipeline"],
)

verilog_library(
    name = "descrambler",
    srcs = ["descrambler.sv"],
    visibility = ["//visibility:public"],
    deps = [
        "//common/pkg:pcs_pkg",
        "//rtl_utils:data_status_pipeline",
    ],
)

verilog_library(
    name = "pcs_decoder",
    srcs = ["pcs_decoder.sv"],
    visibility = ["//visibility:public"],
    deps = [
        "//common/pkg:pcs_pkg",
        "//rtl_utils:data_pipeline",
        "//rtl_utils:data_status_pipeline",
    ],
)

verilog_library(
    name = "rx_pcs",
    srcs = ["rx_pcs.sv"],
    visibility = ["//visibility:public"],
    deps = [
        ":alignment_finder",
        ":block_sync",
        ":descrambler",
        ":pcs_decoder",
        "//common/pkg:pcs_pkg",
    ],
)
