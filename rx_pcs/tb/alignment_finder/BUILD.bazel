load("@rules_cocotb//cocotb:cocotb_test.bzl", "cocotb_test")
load("@rules_python//python:defs.bzl", "py_library")

py_library(
    name = "alignment_finder_tb",
    srcs = [
        "alignment_finder_driver.py",
        "alignment_finder_model.py",
        "alignment_finder_monitor.py",
        "alignment_finder_sequence.py",
        "alignment_finder_sequence_item.py",
        "alignment_finder_test_base.py",
        "alignment_finder_transaction.py",
    ],
    deps = [
        "//common/pkg:pcs_pkg_py",
        "//tb_utils",
        "//tb_utils/net",
        "//tools/cocotb",
    ],
)

cocotb_test(
    name = "alignment_finder_test",
    srcs = ["alignment_finder_test.py"],
    module = "//rx_pcs/rtl:alignment_finder",
    params = [
        "GOOD_COUNT=32",
        "BAD_COUNT=8",
    ],
    deps = [":alignment_finder_tb"],
)
